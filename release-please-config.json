{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "plugins": [
    "node-workspace"
  ],
  "packages": {
    "packages/tokens": {
      "release-type": "node",
      "component": "tokens",
      "package-name": "@nyt87/tokens"
    },
    "packages/icons": {
      "release-type": "node",
      "component": "icons",
      "package-name": "@nyt87/icons"
    },
    "packages/ui": {
      "release-type": "node",
      "component": "ui",
      "package-name": "@nyt87/ui"
    }
  }
}
