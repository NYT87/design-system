{
  "name": "@nyt87/ui",
  "version": "0.2.2",
  "description": "Framework-free UI components for nyt87 products: HTML + CSS, with small vanilla behaviours for the interactive parts",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NYT87/design-system.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./menu": {
      "types": "./dist/menu.d.ts",
      "import": "./dist/menu.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "import": "./dist/tabs.js"
    },
    "./modal": {
      "types": "./dist/modal.d.ts",
      "import": "./dist/modal.js"
    },
    "./copy": {
      "types": "./dist/copy.d.ts",
      "import": "./dist/copy.js"
    },
    "./drop": {
      "types": "./dist/drop.d.ts",
      "import": "./dist/drop.js"
    },
    "./theme-scope": {
      "types": "./dist/theme-scope.d.ts",
      "import": "./dist/theme-scope.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@nyt87/tokens": ">=0.1.1"
  },
  "scripts": {
    "build": "tsup && cp src/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
